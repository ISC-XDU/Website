---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/ui/Section.astro';
import OperateWorkBlock from '@components/sections/OperateWorkBlock.astro';
import ContactCard from '@components/ui/ContactCard.astro';
import contacts from '@data/contacts.json';
---

<PageLayout
  title="运营部"
  description="浪潮俱乐部运营部：活动、宣传、运营三块工作。"
>
  <Section background="dark" containerClass="!py-10">
    <h1 class="heading-display text-3xl md:text-4xl text-white">这里是浪潮运营部</h1>
    <p class="mt-3 text-ink-200">
      浪潮俱乐部的打理人、护航者。致力于挖掘成员潜力，让所有人各尽其才。
    </p>
  </Section>

  <OperateWorkBlock />

  <Section background="muted">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="heading-display text-2xl md:text-3xl text-ink-900">更多精彩可联系</h2>
      <p class="mt-2 text-ink-600">运营部负责人 — 加入我们前可以先聊聊</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
      {
        contacts.map((c) => (
          <ContactCard contact={c} />
        ))
      }
    </div>
  </Section>
</PageLayout>
