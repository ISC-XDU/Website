---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/ui/Section.astro';
import PersonCard from '@components/sections/PersonCard.astro';
import { groupByYear, getYears, getCount } from '@lib/members';

const grouped = groupByYear();
const years = getYears();
const total = getCount();
---

<PageLayout
  title="成员墙"
  description="西电浪潮俱乐部历届成员墙，共收录 {total} 位同学。"
>
  <Section background="default" containerClass="!py-10" reveal>
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h1 class="heading-display text-4xl md:text-5xl text-ink-900 inline-block px-6 py-2 border-4 border-xidian-200 rounded-full">
        成员墙
      </h1>
      <p class="mt-4 text-ink-600 leading-relaxed">
        作为西电高质量俱乐部，浪潮汇聚了大批具有真才实学的有志 XDer，成就浪潮的同时，造就自己的才华和理想。
      </p>
      <p class="mt-2 text-ink-900 font-semibold tracking-wider">卓越 · 追求 · 奋进 · 坚实</p>
      <p class="mt-4 text-sm text-ink-500">共收录 {total} 位成员</p>
    </div>

    {
      years.map((year) => (
        <div class="mb-12 last:mb-0">
          <div class="text-center mb-6">
            <h2 class="heading-display text-2xl md:text-3xl text-ink-900">
              <span class="text-xidian-500">★</span> {year}—{year + 1} 届 <span class="text-xidian-500">★</span>
            </h2>
            <p class="mt-1 text-sm text-ink-500">{grouped[year]?.length ?? 0} 人</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {(grouped[year] ?? []).map((m) => (
              <PersonCard member={m} />
            ))}
          </div>
        </div>
      ))
    }
  </Section>
</PageLayout>
