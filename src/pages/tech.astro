---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/ui/Section.astro';
import TechGroupCard from '@components/sections/TechGroupCard.astro';

const groups = (await getCollection('techGroups')).sort(
  (a, b) => a.data.order - b.data.order
);
const groupCount = groups.length;
---

<PageLayout
  title="技术部"
  description="西电浪潮俱乐部技术部下设 Web 组、AI 组、Agent 组、ACM 组。零基础可学，实战练手做出能落地的产品。"
>
  {/* 头部：黑色 hero + 简短介绍 */}
  <Section background="dark" containerClass="!py-10 md:!py-14" reveal>
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider rounded-full px-3 py-1 mb-3 bg-white/10 text-white/80">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-inspur-400 animate-pulse" aria-hidden="true"></span>
        浪潮俱乐部 · 技术部
      </span>
      <h1 class="heading-display text-3xl md:text-4xl text-white">四个方向，零基础可入</h1>
      <p class="mt-4 text-ink-200 leading-relaxed">
        <span class="text-emerald-400 font-semibold">西电浪潮俱乐部技术部</span>
        致力于为更多同学
        <span class="text-amber-400">创造课业以外的学习机会</span>
        。我们提供不同领域、不同形式的
        <strong class="text-white">竞赛</strong> 和
        <strong class="text-white">学业拓展活动</strong>，让你在大学生活里充满更多可能性。
      </p>
      <p class="mt-3 text-ink-300 text-sm">
        招新时看重 <strong class="text-white">兴趣、态度、学习能力</strong>，没基础完全没关系。
      </p>
    </div>

    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl">
      {groups.map((g) => (
        <a
          href={`#${g.slug}`}
          class="flex items-center justify-between gap-2 px-4 py-3 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-sm text-white/85 hover:text-white transition-colors"
        >
          <span class="font-medium">{g.data.name}</span>
          <span class="text-xs text-white/50">→</span>
        </a>
      ))}
    </div>
  </Section>

  {/* 各组详情 */}
  {
    groups.map((g, i) => (
      <div id={g.slug}>
        <TechGroupCard group={g} index={i} />
      </div>
    ))
  }

  {/* 招新 CTA */}
  <Section background="muted" containerClass="!py-12">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="heading-display text-2xl md:text-3xl text-ink-900">不知道选哪个？</h2>
      <p class="mt-3 text-ink-600">
        4 个组招新不冲突，可以同时报多个。先加招新群聊聊，问问学长学姐。
      </p>
      <a
        href="http://qm.qq.com/cgi-bin/qm/qr?_wv=1027&k=a8Y8NR-m69A3mMLeTFJL1eKM5OcqUiNn&authKey=D4OLWI%2BwQCPie1hnHDAs93iZjlg9LCca5RdO%2BvxeHaumgeU2Af%2BKKuawXFJhS88%2F&noverify=0&group_code=860063761"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-6 px-6 py-3 bg-inspur-600 hover:bg-inspur-700 text-white font-medium rounded-md transition-colors"
      >
        加入招新 Q 群（群号 860063761）
      </a>
    </div>
  </Section>
</PageLayout>
