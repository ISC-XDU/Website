---
import type { CollectionEntry } from 'astro:content';
import Section from '@components/ui/Section.astro';

interface Props {
  group: CollectionEntry<'techGroups'>;
  index: number;
}

const { group, index } = Astro.props;
const { Content } = await group.render();
const isEven = index % 2 === 0;
const variant = isEven ? 'default' : 'muted';
---

<Section background={variant} containerClass="!py-12 md:!py-16">
  <div class="text-center mb-8">
    <h2 class="heading-display text-3xl md:text-4xl text-ink-900 inline-block px-6 py-2 border-4 border-ink-200 rounded-2xl">
      {group.data.name}
    </h2>
    {group.data.tagline && (
      <p class="mt-3 text-ink-600">{group.data.tagline}</p>
    )}
  </div>

  <article class="prose-cn max-w-3xl mx-auto text-ink-700 leading-relaxed">
    <Content />
  </article>
</Section>
