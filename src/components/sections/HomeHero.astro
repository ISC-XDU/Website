---
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import siteData from '@data/site.json';
---

<section class="relative overflow-hidden bg-mesh-light py-20 md:py-32 lg:py-40">
  {/* 浮动装饰球（4 个，错位放置） */}
  <div
    data-orb
    class="absolute top-[10%] left-[8%] w-32 h-32 md:w-48 md:h-48 rounded-full
           bg-gradient-to-br from-inspur-400 to-violet-500 opacity-30 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    data-orb
    class="absolute top-[20%] right-[12%] w-24 h-24 md:w-40 md:h-40 rounded-full
           bg-gradient-to-br from-pink-400 to-xidian-500 opacity-25 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    data-orb
    class="absolute bottom-[15%] left-[20%] w-40 h-40 md:w-56 md:h-56 rounded-full
           bg-gradient-to-br from-cyan-400 to-emerald-500 opacity-20 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    data-orb
    class="absolute bottom-[10%] right-[8%] w-28 h-28 md:w-44 md:h-44 rounded-full
           bg-gradient-to-br from-amber-400 to-xidian-500 opacity-25 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="container-page relative">
    <div class="max-w-4xl mx-auto text-center">
      <span
        class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider rounded-full px-4 py-1.5 mb-6
               glass text-ink-700 dark:text-ink-200"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 pulse-glow" aria-hidden="true"></span>
        浪潮 · ISC
      </span>

      <h1
        class="heading-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-ink-900 dark:text-ink-50 leading-[1.1] tracking-tight"
        data-hero-title
      >
        加入我们成为一名
        <span class="relative inline-block" data-hero-accent>
          <span
            class="text-gradient-rainbow bg-clip-text text-transparent font-extrabold inline-block"
            data-hero-word
          >浪潮er</span>
          <svg
            class="absolute -bottom-2 left-0 w-full"
            viewBox="0 0 200 8"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M0 4 Q 50 0, 100 4 T 200 4"
              fill="none"
              stroke="url(#hero-gradient)"
              stroke-width="3"
              stroke-linecap="round"
              data-hero-accent-path
            />
            <defs>
              <linearGradient id="hero-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#2f6dff" />
                <stop offset="50%" stop-color="#a855f7" />
                <stop offset="100%" stop-color="#ec4899" />
              </linearGradient>
            </defs>
          </svg>
        </span>
      </h1>

      <p
        class="mt-8 text-lg md:text-xl text-ink-700 dark:text-ink-200 leading-relaxed max-w-2xl mx-auto"
        data-hero-subtitle
      >
        <strong class="text-ink-900 dark:text-ink-50">浪潮俱乐部</strong>成立于
        {siteData.founded} 年，是由
        <strong class="text-inspur-600 dark:text-cyan-300">浪潮集团</strong>
        携手我校
        <strong class="text-xidian-500 dark:text-orange-300">计算机学院</strong>
        共同打造的
        <strong class="text-ink-900 dark:text-ink-50">校企联合俱乐部</strong>。
        我们致力于培养成员的
        <strong class="text-ink-900 dark:text-ink-50">学习能力</strong>
        和
        <strong class="text-ink-900 dark:text-ink-50">技术情怀</strong>。
      </p>

      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-3"
        data-hero-ctas
      >
        <Button href="/tech" size="lg" class="shadow-lg shadow-inspur-500/20">
          技术部 →
        </Button>
        <Button href="/operate" size="lg" variant="outline" class="!border-ink-300 !text-ink-700 dark:!border-white/30 dark:!text-white">
          运营部 →
        </Button>
        <Button href="/members" size="lg" variant="ghost" class="!text-ink-700 dark:!text-white hover:!bg-ink-100/50">
          看看成员
        </Button>
      </div>

      <div
        class="mt-10 flex items-center justify-center gap-2 text-sm text-ink-500 dark:text-ink-400"
        data-hero-status
      >
        <span
          class:list={[
            'inline-block w-2 h-2 rounded-full',
            siteData.recruitment.status === 'open'
              ? 'bg-emerald-500 pulse-glow'
              : 'bg-ink-400',
          ]}
          aria-hidden="true"
        ></span>
        <span>{siteData.recruitment.message}</span>
      </div>
    </div>
  </div>

  {/* 滚动指示器 */}
  <div
    data-scroll-indicator
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-ink-400 dark:text-ink-500"
    aria-hidden="true"
  >
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  function initHeroAnimations() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const titleEl = document.querySelector<HTMLElement>('[data-hero-title]');
    if (!titleEl) return;

    // 用 SplitText 拆字符（tagName: 'span' 避免默认 div 破坏父级 inline-block 结构）
    const split = new SplitText(titleEl, {
      type: 'chars',
      charsClass: 'gsap-char',
      tagName: 'span',
    });

    // "浪潮er" 字符（位于 [data-hero-word] 内）需要独立渐变背景。
    // SplitText 不会自动继承父级的 text-gradient-rainbow + bg-clip-text + text-transparent，
    // 父级的 text-transparent 反而会通过 CSS 继承让字符也变成透明文本 → 看不见。
    // 显式给 word 内的字符加 4 个类，让每个字符拥有自己的渐变 background。
    document
      .querySelectorAll<HTMLElement>('[data-hero-word] .gsap-char')
      .forEach((el) => {
        el.classList.add(
          'text-gradient-rainbow',
          'bg-clip-text',
          'text-transparent',
          'font-extrabold'
        );
      });

    // 时间线
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // 浮动球轻微入场
    tl.from(
      '[data-orb]',
      {
        opacity: 0,
        scale: 0.5,
        duration: 1.2,
        stagger: 0.15,
      },
      0
    );

    // 标题字符：依次 y 从 50 落到 0
    tl.from(
      split.chars,
      {
        y: 50,
        opacity: 0,
        rotateX: -60,
        duration: 0.7,
        stagger: 0.04,
      },
      0.2
    );

    // accent 下划线：先直线 scaleX 0→1 绘制，再 morphSVG 直线 → 波浪
    const accentPath = document.querySelector<SVGPathElement>('[data-hero-accent-path]');
    const WAVE_PATH = 'M0 4 Q 50 0, 100 4 T 200 4';
    const STRAIGHT_PATH = 'M0 4 L 200 4';
    if (accentPath) {
      accentPath.setAttribute('d', STRAIGHT_PATH);
      tl.fromTo(
        accentPath,
        { scaleX: 0, transformOrigin: 'left center' },
        { scaleX: 1, duration: 0.45, ease: 'power2.out' },
        0.9
      );
      tl.to(
        accentPath,
        { morphSVG: WAVE_PATH, duration: 0.65, ease: 'power2.inOut' },
        1.35
      );
    }

    // 副文
    tl.from(
      '[data-hero-subtitle]',
      {
        opacity: 0,
        y: 20,
        duration: 0.6,
      },
      1.0
    );

    // CTA 按钮
    tl.from(
      '[data-hero-ctas] > *',
      {
        opacity: 0,
        y: 20,
        scale: 0.9,
        duration: 0.5,
        stagger: 0.1,
      },
      1.2
    );

    // 招新状态条
    tl.from(
      '[data-hero-status]',
      {
        opacity: 0,
        duration: 0.4,
      },
      1.5
    );

    // 浮动球持续呼吸
    gsap.utils.toArray<HTMLElement>('[data-orb]').forEach((orb, i) => {
      gsap.to(orb, {
        y: 'random(-30, 30)',
        x: 'random(-20, 20)',
        duration: 'random(8, 14)',
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
        delay: i * 0.3,
      });
    });

    // 滚动指示器自动隐藏
    const indicator = document.querySelector<HTMLElement>('[data-scroll-indicator]');
    if (indicator) {
      window.addEventListener(
        'scroll',
        () => {
          const opacity = Math.max(0, 1 - window.scrollY / 200);
          indicator.style.opacity = String(opacity);
        },
        { passive: true }
      );
    }
  }

  initHeroAnimations();
</script>
