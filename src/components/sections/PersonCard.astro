---
import Card from '@components/ui/Card.astro';
import Modal from '@components/ui/Modal.astro';
import { getRole, type Member } from '@lib/members';

interface Props {
  member: Member;
}

const { member } = Astro.props;
const modalId = `modal-member-${member.year}-${member.name}`;
const emailLink = member.email ? `mailto:${member.email}` : null;
const role = getRole(member);
---

<Card class="h-full group" interactive data-reveal>
  <div class="relative p-5 text-center flex flex-col items-center h-full">
    {/* 背景渐变装饰球（hover 点亮，风格同主页 StatsBar） */}
    <div
      class="absolute -top-10 -right-10 w-28 h-28 rounded-full bg-gradient-to-br from-inspur-400 to-cyan-400 opacity-10 blur-2xl group-hover:opacity-30 transition-opacity duration-300 pointer-events-none"
      aria-hidden="true"
    ></div>

    {/* 头像：渐变圆环 */}
    <div
      class="relative w-24 h-24 rounded-full p-[3px] mb-3 bg-gradient-to-br from-inspur-400 via-cyan-400 to-xidian-400 shadow-md shadow-inspur-500/10 group-hover:scale-105 transition-transform duration-300"
    >
      <div class="w-full h-full rounded-full overflow-hidden bg-ink-100 ring-1 ring-white/60 dark:ring-black/20">
        <img
          src={member.avatar}
          alt={`${member.name} 头像`}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none'"
        />
      </div>
      {/* 渐变环上的品牌圆点 */}
      <span class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-inspur-500 ring-2 ring-white dark:ring-ink-800" aria-hidden="true"></span>
    </div>

    <h3 class="text-base font-semibold text-ink-900 mb-1.5">{member.name}</h3>

    {/* 身份徽章（从 bio 提取，如"主席"、"技术部部长"） */}
    {role && (
      <span
        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium
               bg-inspur-50 text-inspur-600 border border-inspur-100
               dark:bg-inspur-900/30 dark:text-inspur-300 dark:border-inspur-700/40 mb-2"
      >
        ★ {role}
      </span>
    )}

    <div class="flex items-center gap-2 text-sm flex-wrap justify-center mt-auto">
      <button
        type="button"
        class="text-white bg-inspur-600 hover:bg-inspur-700 px-3 py-1 rounded-md text-xs transition-colors"
        data-modal-open={modalId}
      >
        查看详情
      </button>
      {emailLink && (
        <a
          href={emailLink}
          class="inline-flex items-center gap-1 text-xs text-ink-500 hover:text-inspur-600
                 border border-ink-200 dark:border-ink-700 rounded-md px-2.5 py-1 transition-colors"
        >
          📧 Email
        </a>
      )}
    </div>
  </div>
</Card>

<Modal id={modalId} title={`${member.name} · ${member.year} 级`} size="md">
  {member.bio ? (
    <p class="text-ink-700 leading-relaxed text-sm whitespace-pre-line">{member.bio}</p>
  ) : (
    <p class="text-ink-500 italic">暂无简介</p>
  )}
  {emailLink && (
    <p class="mt-4 text-sm">
      <a href={emailLink} class="text-inspur-600 hover:underline">
        📧 {member.email}
      </a>
    </p>
  )}
</Modal>
