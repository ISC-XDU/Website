---
interface Props {
  id: string;
  title?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, title, size = 'md' } = Astro.props;

const sizes = {
  sm: 'max-w-md',
  md: 'max-w-xl',
  lg: 'max-w-3xl',
};
---

<div
  id={id}
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-ink-900/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  data-modal
>
  <div
    class:list={[
      'relative w-full bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto',
      sizes[size],
    ]}
    data-modal-content
  >
    {
      title && (
        <div class="flex items-center justify-between p-5 border-b border-ink-100">
          <h2 id={`${id}-title`} class="text-lg font-semibold text-ink-900">
            {title}
          </h2>
          <button
            type="button"
            class="p-1.5 rounded-md text-ink-500 hover:text-ink-900 hover:bg-ink-100"
            aria-label="关闭"
            data-modal-close
          >
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      )
    }
    <div class="p-5 md:p-6">
      <slot />
    </div>
  </div>
</div>

<script>
  // Modal 通用行为：open / close / Esc / 点击背景关闭
  function setupModals() {
    document.querySelectorAll('[data-modal]').forEach((modal) => {
      const content = modal.querySelector('[data-modal-content]');
      const closers = modal.querySelectorAll('[data-modal-close]');

      const open = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        // 焦点移到内容
        if (content instanceof HTMLElement) {
          const firstFocusable = content.querySelector(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          (firstFocusable as HTMLElement | null)?.focus();
        }
      };

      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      };

      closers.forEach((btn) => btn.addEventListener('click', close));

      // 点击背景关闭
      modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
      });

      // Esc 关闭
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          close();
        }
      });

      // 暴露 open / close 方法
      (modal as any)._open = open;
      (modal as any)._close = close;
    });
  }

  setupModals();

  // 全局事件：任何带 [data-modal-open="<id>"] 的元素都会打开对应 modal
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const trigger = target?.closest('[data-modal-open]') as HTMLElement | null;
    if (!trigger) return;
    const id = trigger.dataset.modalOpen;
    if (!id) return;
    e.preventDefault();
    const modal = document.getElementById(id);
    if (modal && typeof (modal as any)._open === 'function') {
      (modal as any)._open();
    }
  });
</script>
