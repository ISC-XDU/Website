---
import Card from './Card.astro';

interface Contact {
  name: string;
  badge?: string;
  message: string;
  qq?: string;
  email?: string;
  avatar?: string;
}

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
const qqLink = contact.qq
  ? `https://wpa.qq.com/msgrd?v=3&uin=${contact.qq}&site=qq&menu=yes&jumpflag=1`
  : null;
---

<Card class="h-full">
  <div class="p-5 flex flex-col h-full">
    <div class="flex items-center gap-3 mb-3">
      <div
        class="w-12 h-12 rounded-full bg-gradient-to-br from-inspur-100 to-inspur-200 flex items-center justify-center text-inspur-700 font-semibold flex-shrink-0"
        aria-hidden="true"
      >
        {contact.name.charAt(0)}
      </div>
      <div>
        <h3 class="text-lg font-semibold text-ink-900">{contact.name}</h3>
        {contact.badge && (
          <span class="text-xs text-xidian-500 font-medium">{contact.badge}</span>
        )}
      </div>
    </div>
    <p class="text-sm text-ink-600 leading-relaxed flex-1">"{contact.message}"</p>
    <div class="mt-4 flex items-center gap-3 text-sm">
      {qqLink && (
        <a
          href={qqLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white bg-inspur-600 hover:bg-inspur-700 px-3 py-1.5 rounded-md transition-colors"
        >
          QQ 直达
        </a>
      )}
      {contact.email && (
        <a
          href={`mailto:${contact.email}`}
          class="text-xidian-500 hover:underline"
        >
          Email
        </a>
      )}
    </div>
  </div>
</Card>
