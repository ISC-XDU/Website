---
interface Props {
  class?: string;
  interactive?: boolean;
  as?: 'div' | 'article' | 'section';
}

const {
  class: className = '',
  interactive = false,
  as: Tag = 'div',
  ...rest
}: Props = Astro.props;

const base = 'bg-white rounded-xl border border-ink-100 overflow-hidden';
const interactiveClasses = interactive
  ? 'hover-lift hover:border-inspur-200 cursor-pointer'
  : '';
---

<Tag class:list={[base, interactiveClasses, className]} {...rest}>
  <slot />
</Tag>
