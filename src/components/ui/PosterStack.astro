---
/**
 * PosterStack —— 招新海报扑克牌堆叠 / 横排交互组件
 *
 * 状态机：
 *   - stacked  (默认)  5 张错位堆叠，topIndex 牌在顶
 *   - expanded          5 张横排，topIndex 牌在视觉中心（focus 放大）
 *
 * 交互：
 *   - stacked 态：拖动 topIndex 牌（左右）翻牌 / 点击 topIndex 牌展开
 *   - expanded 态：拖动空白区切换 focus / 点击 focus 牌收回
 *   - 键盘：←→ 翻/切，Enter 展开/收回，Esc 收回
 */

interface Props {
  posters: { src: string; alt: string }[];
  initialIndex?: number;
}

const { posters, initialIndex = 0 } = Astro.props;
---

<div
  class="poster-stack relative w-full h-[420px] sm:h-[520px] md:h-[600px] flex items-center justify-center select-none touch-none"
  data-poster-stack
  data-initial-index={String(Math.max(0, Math.min(initialIndex, posters.length - 1)))}
  role="region"
  aria-label="2026 招新海报画廊"
  tabindex="0"
>
  {
    posters.map((p, i) => (
      <button
        type="button"
        class="poster absolute top-0 left-0 right-0 mx-auto w-[180px] sm:w-[200px] md:w-[220px] aspect-[9/16] rounded-2xl overflow-hidden shadow-xl ring-1 ring-black/5 dark:ring-white/10 bg-white dark:bg-ink-900 cursor-grab active:cursor-grabbing focus:outline-none focus-visible:ring-2 focus-visible:ring-inspur-500 will-change-transform"
        data-poster
        data-poster-index={i}
        aria-label={`海报 ${i + 1} / ${posters.length}：${p.alt}`}
      >
        <img
          src={p.src}
          alt={p.alt}
          loading="lazy"
          decoding="async"
          class="block w-full h-full object-cover pointer-events-none"
          draggable="false"
        />
      </button>
    ))
  }

  {/* 状态指示器：当前 topIndex 牌序号 */}
  <div
    class="absolute bottom-2 left-1/2 -translate-x-1/2 flex items-center gap-1.5 text-xs text-ink-500 dark:text-ink-400"
    data-poster-indicator
    aria-hidden="true"
  >
    {
      posters.map((_, i) => (
        <span
          class="block rounded-full bg-ink-300 dark:bg-ink-600 transition-all duration-300"
          data-poster-dot={i}
        />
      ))
    }
  </div>

  {/* 模式提示（首次进入时短暂显示） */}
  <div
    class="absolute top-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full glass text-xs text-ink-600 dark:text-ink-300 pointer-events-none transition-opacity duration-500"
    data-poster-hint
  >
    <span data-hint-stacked>← 滑动翻牌 · 点击展开 →</span>
    <span data-hint-expanded hidden>← 滑动切换 · 点击收回 →</span>
  </div>
</div>

<style>
  .poster {
    transform-origin: center center;
    user-select: none;
    -webkit-user-drag: none;
  }
  .poster img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
  /* 指示器圆点：非当前尺寸 6px，当前尺寸 24px x 6px */
  [data-poster-dot] {
    width: 6px;
    height: 6px;
  }
  [data-poster-dot].is-active {
    width: 24px;
    background-color: rgb(var(--inspur-500, 47 109 255));
  }
</style>

<script>
  import { gsap } from 'gsap';

  // 堆叠态配置
  const STACK = {
    offsetY: 14, // 后面牌向 y 偏移的步长（px）
    rotateBase: 2.5, // 后面牌旋转基础角度（deg）
    rotateStep: 2, // 每多一层额外加的角度
    scaleStep: 0.04, // 每多一层缩小的比例
    opacityStep: 0.1, // 每多一层透明度降低
  };

  // 展开态配置
  const EXPAND = {
    gapPx: 70, // 中心牌与相邻牌的水平距离系数
    focusScale: 1.18,
    side1Scale: 0.88,
    side2Scale: 0.7,
    focusOpacity: 1,
    side1Opacity: 0.65,
    side2Opacity: 0.3,
    duration: 0.55,
  };

  // 拖动翻牌阈值
  const FLIP_THRESHOLD = 80; // px
  // 展开态拖动切换 focus 的阈值
  const EXPAND_DRAG_THRESHOLD = 50;

  type Mode = 'stacked' | 'expanded';

  function initStack(root: HTMLElement) {
    const posters = Array.from(
      root.querySelectorAll<HTMLElement>('[data-poster]')
    );
    if (posters.length === 0) return;

    const n = posters.length;
    let mode: Mode = 'stacked';
    let topIndex = parseInt(root.dataset.initialIndex ?? '0', 10) || 0;

    // 初始布局
    layoutStack(true);
    updateIndicator();
    showHint('stacked', 4000);

    // 给容器绑定键盘
    root.addEventListener('keydown', handleKey);

    // 给每张牌绑定拖动 + 点击
    posters.forEach((p, i) => {
      setupPosterInteractions(p, i);
    });

    // 容器空白区点击（横排态时点击空白 = 收回）
    root.addEventListener('click', (e) => {
      if (mode === 'expanded' && e.target === root) {
        collapse();
      }
    });

    // 容器横排态拖动（切换 focus）
    setupContainerDrag(root);

    // ---------- 布局：堆叠 ----------
    function layoutStack(immediate = false) {
      posters.forEach((p, i) => {
        // dist: 该牌距离顶部位数（0 = 当前顶）
        const dist = (i - topIndex + n) % n;
        const z = n - dist;

        const y = dist * STACK.offsetY;
        const rotate =
          dist === 0
            ? 0
            : (i % 2 === 0 ? 1 : -1) *
              (STACK.rotateBase + dist * STACK.rotateStep);
        const scale = 1 - dist * STACK.scaleStep;
        const opacity = Math.max(0.5, 1 - dist * STACK.opacityStep);

        const tween = {
          y,
          x: 0,
          rotate,
          scale,
          opacity,
          duration: immediate ? 0 : 0.55,
          ease: 'power3.out',
          overwrite: 'auto' as const,
        };

        if (immediate) {
          gsap.set(p, { ...tween, zIndex: z });
        } else {
          gsap.to(p, { ...tween, zIndex: z });
        }
      });
    }

    // ---------- 布局：展开 ----------
    function layoutExpand() {
      posters.forEach((p, i) => {
        // 环形距离：以 topIndex 为 0，左右各 ±1, ±2
        let dist = (i - topIndex + n) % n;
        if (dist > n / 2) dist -= n;

        const absDist = Math.abs(dist);
        const xOffset = dist * EXPAND.gapPx * 1.8;
        const scale =
          dist === 0
            ? EXPAND.focusScale
            : absDist === 1
              ? EXPAND.side1Scale
              : EXPAND.side2Scale;
        const opacity =
          dist === 0
            ? EXPAND.focusOpacity
            : absDist === 1
              ? EXPAND.side1Opacity
              : EXPAND.side2Opacity;
        const z = dist === 0 ? 10 : 5 - absDist;

        gsap.to(p, {
          x: xOffset,
          y: 0,
          rotate: 0,
          scale,
          opacity,
          zIndex: z,
          duration: EXPAND.duration,
          ease: 'power3.out',
          overwrite: 'auto',
        });
      });
    }

    // ---------- 单张牌：拖动 + 点击 ----------
    function setupPosterInteractions(el: HTMLElement, index: number) {
      let isDown = false;
      let isHorizontal = false;
      let startX = 0;
      let startY = 0;
      let dx = 0;
      let dy = 0;
      let moved = false;

      el.addEventListener('pointerdown', (e) => {
        // 只在堆叠态 + 当前顶部牌可拖
        if (mode !== 'stacked') return;
        if (index !== topIndex) return;

        isDown = true;
        isHorizontal = false;
        startX = e.clientX;
        startY = e.clientY;
        dx = 0;
        dy = 0;
        moved = false;
        el.setPointerCapture(e.pointerId);
        gsap.to(el, { scale: 1.05, duration: 0.2, overwrite: 'auto' });
      });

      el.addEventListener('pointermove', (e) => {
        if (!isDown) return;
        dx = e.clientX - startX;
        dy = e.clientY - startY;

        if (!isHorizontal) {
          if (Math.abs(dx) > 8) {
            isHorizontal = true;
            moved = true;
          } else {
            return;
          }
        }

        // 跟手倾斜
        const rotation = dx * 0.06;
        gsap.set(el, {
          x: dx,
          y: dy * 0.3,
          rotate: rotation,
        });
      });

      el.addEventListener('pointerup', (e) => {
        if (!isDown) return;
        isDown = false;
        try {
          el.releasePointerCapture(e.pointerId);
        } catch {
          /* noop */
        }

        if (Math.abs(dx) > FLIP_THRESHOLD) {
          flipTopCard(dx > 0 ? 'right' : 'left');
        } else {
          // 回弹
          gsap.to(el, {
            x: 0,
            y: 0,
            rotate: 0,
            scale: 1,
            duration: 0.45,
            ease: 'power3.out',
            overwrite: 'auto',
          });
        }
      });

      el.addEventListener('pointercancel', () => {
        isDown = false;
        gsap.to(el, {
          x: 0,
          y: 0,
          rotate: 0,
          scale: 1,
          duration: 0.3,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      });

      // 点击展开 / 收回
      el.addEventListener('click', (e) => {
        if (moved) {
          // 拖动过则不触发 click
          moved = false;
          return;
        }
        if (mode === 'stacked' && index === topIndex) {
          expand();
        } else if (mode === 'expanded' && index === topIndex) {
          collapse();
        }
      });
    }

    // ---------- 翻牌（左/右） ----------
    function flipTopCard(direction: 'left' | 'right') {
      const top = posters[topIndex];
      const targetX = direction === 'left' ? -window.innerWidth * 0.8 : window.innerWidth * 0.8;
      const targetRotate = direction === 'left' ? -25 : 25;

      gsap.to(top, {
        x: targetX,
        rotate: targetRotate,
        opacity: 0,
        duration: 0.45,
        ease: 'power2.in',
        overwrite: 'auto',
        onComplete: () => {
          // topIndex 移位
          topIndex =
            direction === 'left'
              ? (topIndex + 1) % n
              : (topIndex - 1 + n) % n;
          // 重置原顶牌 transform
          gsap.set(top, { x: 0, y: 0, rotate: 0, opacity: 1, scale: 1 });
          layoutStack();
          updateIndicator();
        },
      });
    }

    // ---------- 展开 / 收回 ----------
    function expand() {
      mode = 'expanded';
      layoutExpand();
      updateIndicator();
      showHint('expanded', 4000);
    }

    function collapse() {
      mode = 'stacked';
      layoutStack();
      showHint('stacked', 4000);
    }

    // ---------- 容器拖动：横排态切换 focus ----------
    function setupContainerDrag(container: HTMLElement) {
      let isDown = false;
      let startX = 0;
      let dx = 0;

      container.addEventListener('pointerdown', (e) => {
        if (mode !== 'expanded') return;
        // 拖牌上的 pointer 已被 poster 自己处理，这里不重复
        isDown = true;
        startX = e.clientX;
        dx = 0;
        try {
          container.setPointerCapture(e.pointerId);
        } catch {
          /* noop */
        }
      });

      container.addEventListener('pointermove', (e) => {
        if (!isDown) return;
        dx = e.clientX - startX;
      });

      container.addEventListener('pointerup', (e) => {
        if (!isDown) return;
        isDown = false;
        try {
          container.releasePointerCapture(e.pointerId);
        } catch {
          /* noop */
        }

        if (Math.abs(dx) > EXPAND_DRAG_THRESHOLD) {
          topIndex = dx > 0
            ? (topIndex - 1 + n) % n
            : (topIndex + 1) % n;
          layoutExpand();
          updateIndicator();
        }
      });
    }

    // ---------- 指示器 ----------
    function updateIndicator() {
      const dots = container().querySelectorAll<HTMLElement>('[data-poster-dot]');
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === topIndex);
      });
    }

    function container() {
      return root;
    }

    // ---------- 提示 ----------
    let hintTimer: number | undefined;
    function showHint(which: Mode, durationMs: number) {
      const hint = root.querySelector<HTMLElement>('[data-poster-hint]');
      if (!hint) return;
      const stacked = hint.querySelector<HTMLElement>('[data-hint-stacked]');
      const expanded = hint.querySelector<HTMLElement>('[data-hint-expanded]');
      if (!stacked || !expanded) return;

      stacked.hidden = which !== 'stacked';
      expanded.hidden = which !== 'expanded';
      hint.style.opacity = '1';

      if (hintTimer) window.clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => {
        hint.style.opacity = '0';
      }, durationMs);
    }

    // ---------- 键盘 ----------
    function handleKey(e: KeyboardEvent) {
      if (mode === 'stacked') {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          flipTopCard('left');
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          flipTopCard('right');
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          expand();
        }
      } else {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          topIndex = (topIndex - 1 + n) % n;
          layoutExpand();
          updateIndicator();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          topIndex = (topIndex + 1) % n;
          layoutExpand();
          updateIndicator();
        } else if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          collapse();
        }
      }
    }
  }

  // 初始化
  function initAll() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document
      .querySelectorAll<HTMLElement>('[data-poster-stack]')
      .forEach(initStack);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>
