---
/**
 * PosterStack —— 招新海报扑克牌堆叠 / 横排交互组件
 *
 * 状态机：
 *   - stacked  (默认)  5 张错位堆叠，topIndex 牌在顶
 *   - expanded          5 张横排，topIndex 牌在视觉中心（focus 放大）
 *
 * 交互：
 *   - stacked 态：拖动 topIndex 牌（左右）翻牌 / 点击 topIndex 牌展开
 *   - expanded 态：拖动空白区切换 focus / 点击 focus 牌收回
 *   - 键盘：←→ 翻/切，Enter 展开/收回，Esc 收回
 *
 * 纯 CSS + 自写 JS 实现，避免 GSAP 3.15 ESM 在 Vite inline 时的 TDZ 问题。
 */

interface Props {
  posters: { src: string; alt: string }[];
  initialIndex?: number;
}

const { posters, initialIndex = 0 } = Astro.props;
---

<div
  class="poster-stack relative w-full h-[420px] sm:h-[520px] md:h-[600px] flex items-center justify-center select-none touch-none"
  data-poster-stack
  data-initial-index={String(Math.max(0, Math.min(initialIndex, posters.length - 1)))}
  role="region"
  aria-label="2026 招新海报画廊"
  tabindex="0"
>
  {
    posters.map((p, i) => (
      <button
        type="button"
        class="poster absolute inset-0 m-auto w-[180px] h-[320px] sm:w-[200px] sm:h-[356px] md:w-[220px] md:h-[392px] rounded-2xl overflow-hidden shadow-xl ring-1 ring-black/5 dark:ring-white/10 bg-white dark:bg-ink-900 cursor-grab active:cursor-grabbing focus:outline-none focus-visible:ring-2 focus-visible:ring-inspur-500"
        data-poster
        data-poster-index={i}
        aria-label={`海报 ${i + 1} / ${posters.length}：${p.alt}`}
      >
        <img
          src={p.src}
          alt={p.alt}
          loading="lazy"
          decoding="async"
          class="block w-full h-full object-cover pointer-events-none"
          draggable="false"
        />
      </button>
    ))
  }

  {/* 状态指示器：当前 topIndex 牌序号 */}
  <div
    class="absolute bottom-2 left-1/2 -translate-x-1/2 flex items-center gap-1.5 text-xs text-ink-500 dark:text-ink-400"
    data-poster-indicator
    aria-hidden="true"
  >
    {
      posters.map((_, i) => (
        <span
          class="block rounded-full bg-ink-300 dark:bg-ink-600 transition-all duration-300"
          data-poster-dot={i}
        />
      ))
    }
  </div>

  {/* 模式提示（首次进入时短暂显示） */}
  <div
    class="absolute top-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full glass text-xs text-ink-600 dark:text-ink-300 pointer-events-none transition-opacity duration-500 opacity-0"
    data-poster-hint
  >
    <span data-hint-stacked>← 滑动翻牌 · 点击展开 →</span>
    <span data-hint-expanded hidden>← 滑动切换 · 点击收回 →</span>
  </div>
</div>

<style>
  .poster {
    transform-origin: center center;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1),
      opacity 0.4s ease-out;
    will-change: transform, opacity;
    user-select: none;
    -webkit-user-drag: none;
    backface-visibility: hidden;
  }
  .poster img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
  /* 指示器圆点：非当前尺寸 6px，当前尺寸 24px x 6px */
  [data-poster-dot] {
    width: 6px;
    height: 6px;
  }
  [data-poster-dot].is-active {
    width: 24px;
    background-color: rgb(var(--inspur-500, 47 109 255));
  }
  /* 翻牌飞出动画：用 transition 而非 GSAP */
  .poster.is-flipping {
    transition: transform 0.45s cubic-bezier(0.55, 0.05, 0.85, 0.3),
      opacity 0.45s ease-in;
  }
</style>

<script>
  // 纯 JS 状态管理 + CSS transition 实现，避免 GSAP ESM TDZ 陷阱

  // 堆叠态配置
  const STACK = {
    offsetY: 14,
    rotateBase: 2.5,
    rotateStep: 2,
    scaleStep: 0.04,
    opacityStep: 0.1,
  };

  // 展开态配置
  const EXPAND = {
    gapPx: 70,
    focusScale: 1.18,
    side1Scale: 0.88,
    side2Scale: 0.7,
    focusOpacity: 1,
    side1Opacity: 0.65,
    side2Opacity: 0.3,
  };

  const FLIP_THRESHOLD = 80;
  const EXPAND_DRAG_THRESHOLD = 50;

  type Mode = 'stacked' | 'expanded';

  function initStack(root: HTMLElement) {
    const posters = Array.from(
      root.querySelectorAll<HTMLElement>('[data-poster]')
    );
    if (posters.length === 0) return;

    const n = posters.length;
    let mode: Mode = 'stacked';
    let topIndex = parseInt(root.dataset.initialIndex ?? '0', 10) || 0;
    // 记录每张牌已应用的 transform，避免被 stale 值覆盖
    const currentTransforms = new Map<HTMLElement, string>();
    // hint chip 定时器：必须在所有函数声明之前初始化，
    // 因为 showHint() 在 initStack 函数体内 early 就被调用（layoutStack/updateIndicator/showHint 顺序），
    // 否则会触发 `let` 的 TDZ（Cannot access 'hintTimer' before initialization）
    let hintTimer: number | undefined;

    function getTransform(el: HTMLElement): { x: number; y: number; rot: number; scale: number; opacity: number } {
      const t = currentTransforms.get(el);
      if (t) {
        const m = t.match(/translate3d\(([^,]+)px,\s*([^,]+)px,\s*0px\)\s*rotate\((-?[\d.]+)deg\)\s*scale\(([\d.]+)\)/);
        if (m) {
          return { x: parseFloat(m[1]), y: parseFloat(m[2]), rot: parseFloat(m[3]), scale: parseFloat(m[4]), opacity: parseFloat(el.style.opacity || '1') };
        }
      }
      return { x: 0, y: 0, rot: 0, scale: 1, opacity: 1 };
    }

    function applyTransform(el: HTMLElement, t: { x: number; y: number; rot: number; scale: number; opacity: number }, immediate = false) {
      const transform = `translate3d(${t.x}px, ${t.y}px, 0px) rotate(${t.rot}deg) scale(${t.scale})`;
      currentTransforms.set(el, transform);
      if (immediate) {
        el.style.transition = 'none';
        el.style.transform = transform;
        el.style.opacity = String(t.opacity);
        // 强制 reflow 让 immediate 生效
        void el.offsetHeight;
        el.style.transition = '';
      } else {
        el.style.transform = transform;
        el.style.opacity = String(t.opacity);
      }
    }

    function setZIndex(el: HTMLElement, z: number) {
      el.style.zIndex = String(z);
    }

    // 初始布局
    layoutStack(true);
    updateIndicator();
    showHint('stacked', 4000);

    root.addEventListener('keydown', handleKey);

    posters.forEach((p, i) => {
      setupPosterInteractions(p, i);
    });

    root.addEventListener('click', (e) => {
      if (mode === 'expanded' && e.target === root) {
        collapse();
      }
    });

    setupContainerDrag(root);

    function layoutStack(immediate = false) {
      posters.forEach((p, i) => {
        const dist = (i - topIndex + n) % n;
        const z = n - dist;
        const y = dist * STACK.offsetY;
        const rot =
          dist === 0
            ? 0
            : (i % 2 === 0 ? 1 : -1) *
              (STACK.rotateBase + dist * STACK.rotateStep);
        const scale = 1 - dist * STACK.scaleStep;
        const opacity = Math.max(0.5, 1 - dist * STACK.opacityStep);

        setZIndex(p, z);
        applyTransform(p, { x: 0, y, rot, scale, opacity }, immediate);
      });
    }

    function layoutExpand() {
      posters.forEach((p, i) => {
        let dist = (i - topIndex + n) % n;
        if (dist > n / 2) dist -= n;

        const absDist = Math.abs(dist);
        const xOffset = dist * EXPAND.gapPx * 1.8;
        const scale =
          dist === 0
            ? EXPAND.focusScale
            : absDist === 1
              ? EXPAND.side1Scale
              : EXPAND.side2Scale;
        const opacity =
          dist === 0
            ? EXPAND.focusOpacity
            : absDist === 1
              ? EXPAND.side1Opacity
              : EXPAND.side2Opacity;
        const z = dist === 0 ? 10 : 5 - absDist;

        setZIndex(p, z);
        applyTransform(p, { x: xOffset, y: 0, rot: 0, scale, opacity });
      });
    }

    function setupPosterInteractions(el: HTMLElement, index: number) {
      let isDown = false;
      let isHorizontal = false;
      let startX = 0;
      let startY = 0;
      let dx = 0;
      let dy = 0;
      let moved = false;
      let pointerId: number | null = null;

      el.addEventListener('pointerdown', (e) => {
        if (mode !== 'stacked') return;
        if (index !== topIndex) return;

        isDown = true;
        isHorizontal = false;
        startX = e.clientX;
        startY = e.clientY;
        dx = 0;
        dy = 0;
        moved = false;
        pointerId = e.pointerId;
        try {
          el.setPointerCapture(e.pointerId);
        } catch {
          /* noop */
        }
        // 临时去掉 transition，让跟手流畅
        el.classList.add('is-dragging');
        el.style.transition = 'none';
        const t = getTransform(el);
        applyTransform(el, { ...t, scale: 1.05 });
      });

      el.addEventListener('pointermove', (e) => {
        if (!isDown) return;
        dx = e.clientX - startX;
        dy = e.clientY - startY;

        if (!isHorizontal) {
          if (Math.abs(dx) > 8) {
            isHorizontal = true;
            moved = true;
          } else {
            return;
          }
        }

        const t = getTransform(el);
        const rot = dx * 0.06;
        applyTransform(el, { ...t, x: dx, y: dy * 0.3, rot });
      });

      el.addEventListener('pointerup', () => {
        if (!isDown) return;
        isDown = false;
        if (pointerId !== null) {
          try {
            el.releasePointerCapture(pointerId);
          } catch {
            /* noop */
          }
          pointerId = null;
        }
        el.classList.remove('is-dragging');
        el.style.transition = '';

        if (Math.abs(dx) > FLIP_THRESHOLD) {
          flipTopCard(dx > 0 ? 'right' : 'left');
        } else {
          // 回弹
          const t = getTransform(el);
          applyTransform(el, { ...t, x: 0, y: 0, rot: 0, scale: 1 });
        }
      });

      el.addEventListener('pointercancel', () => {
        isDown = false;
        el.classList.remove('is-dragging');
        el.style.transition = '';
        const t = getTransform(el);
        applyTransform(el, { ...t, x: 0, y: 0, rot: 0, scale: 1 });
      });

      el.addEventListener('click', () => {
        if (moved) {
          moved = false;
          return;
        }
        if (mode === 'stacked' && index === topIndex) {
          expand();
        } else if (mode === 'expanded' && index === topIndex) {
          collapse();
        }
      });
    }

    function flipTopCard(direction: 'left' | 'right') {
      const top = posters[topIndex];
      const targetX = direction === 'left' ? -window.innerWidth * 0.8 : window.innerWidth * 0.8;
      const targetRot = direction === 'left' ? -25 : 25;

      // 用 is-flipping class 让 transition 用 cubic-bezier
      top.classList.add('is-flipping');
      const t = getTransform(top);
      applyTransform(top, { ...t, x: targetX, rot: targetRot, opacity: 0 });

      const onEnd = () => {
        top.removeEventListener('transitionend', onEnd);
        top.classList.remove('is-flipping');
        // 移动 topIndex
        topIndex =
          direction === 'left'
            ? (topIndex + 1) % n
            : (topIndex - 1 + n) % n;
        // 重置原顶牌 transform
        currentTransforms.delete(top);
        top.style.transition = 'none';
        top.style.transform = '';
        top.style.opacity = '';
        void top.offsetHeight;
        top.style.transition = '';
        // 重新布局堆叠（让新顶牌的 layoutStack 覆盖 z-index / transform）
        layoutStack(true);
        updateIndicator();
      };
      top.addEventListener('transitionend', onEnd);

      // 兜底：500ms 后强制结束（防止 transitionend 不触发）
      window.setTimeout(onEnd, 500);
    }

    function expand() {
      mode = 'expanded';
      layoutExpand();
      updateIndicator();
      showHint('expanded', 4000);
    }

    function collapse() {
      mode = 'stacked';
      layoutStack();
      showHint('stacked', 4000);
    }

    function setupContainerDrag(container: HTMLElement) {
      let isDown = false;
      let startX = 0;
      let dx = 0;
      let pointerId: number | null = null;

      container.addEventListener('pointerdown', (e) => {
        if (mode !== 'expanded') return;
        // 拖牌上的 pointer 已被 poster 自己处理
        const target = e.target as HTMLElement;
        if (target.closest('[data-poster]')) return;
        isDown = true;
        startX = e.clientX;
        dx = 0;
        pointerId = e.pointerId;
        try {
          container.setPointerCapture(e.pointerId);
        } catch {
          /* noop */
        }
      });

      container.addEventListener('pointermove', (e) => {
        if (!isDown) return;
        dx = e.clientX - startX;
      });

      container.addEventListener('pointerup', () => {
        if (!isDown) return;
        isDown = false;
        if (pointerId !== null) {
          try {
            container.releasePointerCapture(pointerId);
          } catch {
            /* noop */
          }
          pointerId = null;
        }

        if (Math.abs(dx) > EXPAND_DRAG_THRESHOLD) {
          topIndex = dx > 0
            ? (topIndex - 1 + n) % n
            : (topIndex + 1) % n;
          layoutExpand();
          updateIndicator();
        }
      });
    }

    function updateIndicator() {
      const dots = root.querySelectorAll<HTMLElement>('[data-poster-dot]');
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === topIndex);
      });
    }

    function showHint(which: Mode, durationMs: number) {
      const hint = root.querySelector<HTMLElement>('[data-poster-hint]');
      if (!hint) return;
      const stacked = hint.querySelector<HTMLElement>('[data-hint-stacked]');
      const expanded = hint.querySelector<HTMLElement>('[data-hint-expanded]');
      if (!stacked || !expanded) return;

      stacked.hidden = which !== 'stacked';
      expanded.hidden = which !== 'expanded';
      hint.style.opacity = '1';

      if (hintTimer) window.clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => {
        hint.style.opacity = '0';
      }, durationMs);
    }

    function handleKey(e: KeyboardEvent) {
      if (mode === 'stacked') {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          flipTopCard('left');
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          flipTopCard('right');
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          expand();
        }
      } else {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          topIndex = (topIndex - 1 + n) % n;
          layoutExpand();
          updateIndicator();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          topIndex = (topIndex + 1) % n;
          layoutExpand();
          updateIndicator();
        } else if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          collapse();
        }
      }
    }
  }

  function initAll() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document
      .querySelectorAll<HTMLElement>('[data-poster-stack]')
      .forEach(initStack);
  }

  if (document.readyState === 'complete') {
    initAll();
  } else {
    window.addEventListener('load', () => setTimeout(initAll, 0));
  }
</script>
