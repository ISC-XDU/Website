---
interface Props {
  class?: string;
  containerClass?: string;
  background?: 'default' | 'muted' | 'dark' | 'gradient';
  id?: string;
  reveal?: boolean;
  revealDelay?: 0 | 1 | 2 | 3 | 4;
}

const {
  class: className = '',
  containerClass = '',
  background = 'default',
  id,
  reveal = false,
  revealDelay = 0,
} = Astro.props;

const backgrounds = {
  default: 'bg-white',
  muted: 'bg-ink-50',
  dark: 'bg-ink-900 text-white',
  gradient: 'bg-gradient-to-br from-inspur-50 via-white to-inspur-50',
};

const sectionClass = `${backgrounds[background]} ${className}`;

// 滚动入场标记：被 RevealOnScroll 的 ScrollTrigger.batch 接管
const revealAttrs: Record<string, string> = reveal
  ? { 'data-reveal': '', 'data-reveal-delay': String(revealDelay * 0.08) }
  : {};
---

<section id={id} class={sectionClass} class:list={['py-12 md:py-20']} {...revealAttrs}>
  <div class:list={['container-page', containerClass]}>
    <slot />
  </div>
</section>
