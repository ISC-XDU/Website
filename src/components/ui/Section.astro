---
interface Props {
  class?: string;
  containerClass?: string;
  background?: 'default' | 'muted' | 'dark' | 'gradient';
  id?: string;
  reveal?: boolean;
  revealDelay?: 0 | 1 | 2 | 3 | 4;
}

const {
  class: className = '',
  containerClass = '',
  background = 'default',
  id,
  reveal = false,
  revealDelay = 0,
} = Astro.props;

const backgrounds = {
  default: 'bg-white',
  muted: 'bg-ink-50',
  dark: 'bg-ink-900 text-white',
  gradient: 'bg-gradient-to-br from-inspur-50 via-white to-inspur-50',
};

const sectionClass = `${backgrounds[background]} ${className}`;
const revealClass = reveal
  ? `reveal${revealDelay > 0 ? ` reveal-delay-${revealDelay}` : ''}`
  : '';
---

<section id={id} class:list={[sectionClass, 'py-12 md:py-20', revealClass]}>
  <div class:list={['container-page', containerClass]}>
    <slot />
  </div>
</section>
