---
/**
 * 深色模式切换
 * - 基于 checkbox（无 JS 框架依赖）
 * - 写 <html data-theme="..."> + localStorage
 * - 视觉：经典 IO 开关（pill 轨道 + 圆形 thumb）
 * - 动态效果：整组 scaleX(-1) 镜像翻转 + thumb 滑动 + 颜色过渡
 */
---

<style>
  /* 整组镜像翻转（参考 Uiverse 原始效果） */
  .theme-toggle-label {
    transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
  }
  .theme-toggle-input:checked + .theme-toggle-label {
    transform: scaleX(-1);
  }

  /* 轨道颜色 */
  .theme-toggle-track {
    transition: background-color 0.4s, border-color 0.4s;
  }

  /* thumb 滑动 */
  .theme-toggle-thumb {
    transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55),
                background-color 0.4s;
  }
  .theme-toggle-input:checked + .theme-toggle-label .theme-toggle-thumb {
    transform: translateX(32px);
  }

  /* sun / moon 透明度 */
  .theme-toggle-sun,
  .theme-toggle-moon {
    transition: opacity 0.3s, transform 0.3s;
  }
  .theme-toggle-input:checked + .theme-toggle-label .theme-toggle-sun {
    opacity: 0.2;
    transform: scale(0.6);
  }
  .theme-toggle-input:not(:checked) + .theme-toggle-label .theme-toggle-moon {
    opacity: 0.2;
    transform: scale(0.6);
  }
</style>

<label
  for="theme-toggle"
  class="theme-toggle relative inline-block w-16 h-8 cursor-pointer select-none"
  title="切换深色模式"
>
  <input
    type="checkbox"
    id="theme-toggle"
    class="theme-toggle-input sr-only peer"
    aria-label="切换深色模式"
  />

  <span
    class="theme-toggle-label absolute inset-0 block rounded-full border-2 border-ink-900
           bg-ink-100 peer-checked:bg-ink-900"
  >
    {/* 太阳（亮模式亮） */}
    <span
      class="theme-toggle-sun absolute left-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full border-2 border-ink-900"
      aria-hidden="true"
    ></span>

    {/* 月牙（暗模式亮） */}
    <span
      class="theme-toggle-moon absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-1 rounded-full bg-ink-900"
      aria-hidden="true"
    ></span>

    {/* 滑动的 thumb：纯白圆（亮暗模式同色） */}
    <span
      class="theme-toggle-thumb absolute top-0 left-0 w-8 h-8 rounded-full
             bg-white border-2 border-ink-900 shadow-sm"
      aria-hidden="true"
    ></span>
  </span>
</label>

<script>
  function setupThemeToggle() {
    const cb = document.getElementById('theme-toggle') as HTMLInputElement | null;
    if (!cb) return;

    // 初始状态：从 data-theme 同步
    const current = document.documentElement.dataset.theme;
    cb.checked = current === 'dark';

    cb.addEventListener('change', () => {
      const isDark = cb.checked;
      document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // localStorage 不可用时静默
      }
    });
  }

  setupThemeToggle();
</script>
