---
import navData from '@data/nav.json';
import siteData from '@data/site.json';

interface Props {
  variant?: 'home' | 'subpage';
}

const { variant = 'subpage' } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = variant === 'home';

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header
  class:list={[
    'fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-black border-b border-white/10 text-white',
  ]}
  data-header
  data-variant={variant}
>
  {/* 滚动进度条（wpkoi 风格） */}
  <div
    class="absolute bottom-0 left-0 h-0.5 bg-inspur-400 origin-left scale-x-0 transition-transform duration-150"
    data-scroll-progress
    aria-hidden="true"
  ></div>

  <nav class="container-page" aria-label="主导航">
    <div class="flex items-center h-16">
      <!-- Logo 区（统一深色背景：浪潮集团 LOGO 主 + 浪潮俱乐部图标辅） -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label={`${siteData.name} 首页`}>
        {isHome ? (
          <>
            {/* 主页：西电红章（外链）+ 浪潮集团 LOGO（首页内链） */}
            <a
              href="https://www.xidian.edu.cn/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform hover:scale-105"
              aria-label="西安电子科技大学官网"
            >
              <img
                src="/img/xdu/xdulogo.png"
                alt="西安电子科技大学"
                class="h-9 w-9 sm:h-10 sm:w-10"
                style="background: transparent;"
              />
            </a>
            <span class="hidden sm:inline-block w-px h-7 bg-white/20" aria-hidden="true"></span>
            <img
              src="/img/inspur/inspur_logo.png"
              alt="浪潮集团"
              class="h-7 sm:h-8 w-auto transition-transform group-hover:scale-105"
              style="background: transparent; mix-blend-mode: screen;"
            />
            <span
              class="font-display font-bold text-base sm:text-lg text-white hidden md:inline tracking-wide"
            >
              {siteData.shortName}
            </span>
          </>
        ) : (
          <>
            {/* 子页：浪潮俱乐部图标（外链到 inspur.com，2x 放大）+ 浪潮集团 LOGO + 文字 */}
            <a
              href="https://www.inspur.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform hover:scale-105 shrink-0"
              aria-label="浪潮 Inspur 官网"
            >
              <img
                src="/img/icon/inspur.png"
                alt="浪潮 Inspur"
                class="h-10 w-10 sm:h-12 sm:w-12 brightness-0 invert"
                style="background: transparent;"
              />
            </a>
            <span class="hidden sm:inline-block w-px h-10 bg-white/20" aria-hidden="true"></span>
            <img
              src="/img/inspur/inspur_logo.png"
              alt="浪潮集团 Inspur"
              class="h-7 sm:h-8 w-auto opacity-95 transition-transform group-hover:scale-105"
              style="background: transparent; mix-blend-mode: screen;"
            />
            <span
              class="font-display font-bold text-base sm:text-lg text-white hidden md:inline tracking-wide"
            >
              {siteData.shortName}
            </span>
          </>
        )}
      </a>

      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-1 ml-auto">
        {
          navData.map((item) => (
            <li class="relative group">
              {item.children ? (
                <>
                  <button
                    type="button"
                    class="px-3 py-2 text-sm font-medium text-white/90 hover:text-white rounded-md transition-colors flex items-center gap-1"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-dropdown-trigger
                  >
                    {item.label}
                    <svg
                      class="w-4 h-4 transition-transform group-hover:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                  <ul
                    class="absolute right-0 top-full mt-1 min-w-[10rem] py-1 bg-white border border-ink-100 rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all"
                    role="menu"
                  >
                    {item.children.map((child) => (
                      <li role="none">
                        <a
                          href={child.href}
                          role="menuitem"
                          class:list={[
                            'block px-4 py-2 text-sm hover:bg-inspur-50 hover:text-inspur-700 transition-colors',
                            isActive(child.href) ? 'text-inspur-600 font-medium' : 'text-ink-700',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'px-3 py-2 text-sm font-medium rounded-md transition-colors relative',
                    isActive(item.href) ? 'text-white' : 'text-white/85 hover:text-white',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {/* 当前页底部小竖线指示 */}
                  {isActive(item.href) && (
                    <span
                      class="absolute -bottom-1 left-3 right-3 h-0.5 bg-white rounded-full"
                      aria-hidden="true"
                    ></span>
                  )}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 rounded-md text-white hover:bg-white/10 transition-colors"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-trigger
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden py-3 border-t border-white/10"
      data-mobile-menu
    >
      <ul class="space-y-1">
        {
          navData.map((item) => (
            <li>
              {item.children ? (
                <details class="group">
                  <summary
                    class="flex items-center justify-between px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10 rounded-md cursor-pointer transition-colors"
                  >
                    {item.label}
                    <svg
                      class="w-4 h-4 transition-transform group-open:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <ul class="mt-1 ml-4 space-y-1 pl-2 border-l-2 border-white/20">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-3 py-2 text-sm rounded-md transition-colors',
                            isActive(child.href)
                              ? 'text-white font-medium'
                              : 'text-white/80 hover:bg-white/10',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3 py-2 text-sm font-medium rounded-md transition-colors',
                    isActive(item.href)
                      ? 'text-white bg-white/10'
                      : 'text-white/90 hover:bg-white/10',
                  ]}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  // 1. 移动端菜单开关
  const trigger = document.querySelector('[data-mobile-menu-trigger]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (trigger && menu) {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }

  // 2. wpkoi 风格：滚动进度条
  const progress = document.querySelector('[data-scroll-progress]') as HTMLElement | null;

  function onScroll() {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    const pct = total > 0 ? doc.scrollTop / total : 0;
    if (progress) {
      progress.style.transform = `scaleX(${pct})`;
    }
  }

  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 3. wpkoi 风格：滚动进入视口时元素淡入上浮
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => io.observe(el));
  } else {
    // 降级：直接全部显示
    document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
      el.classList.add('is-revealed');
    });
  }
</script>
