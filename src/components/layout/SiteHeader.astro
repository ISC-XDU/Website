---
import navData from '@data/nav.json';
import siteData from '@data/site.json';

interface Props {
  variant?: 'home' | 'subpage';
}

const { variant = 'subpage' } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = variant === 'home';

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

// subpage 顶部背景：校园风景图 + 暗色渐变蒙版，保证文字可读
const headerBgStyle = isHome
  ? undefined
  : "background-image: linear-gradient(rgba(15, 23, 42, 0.55), rgba(15, 23, 42, 0.65)), url('/img/xdu/xd_sunsetting.jpg'); background-size: cover; background-position: center 30%;";
---

<header
  class:list={[
    'fixed top-0 left-0 right-0 z-40 transition-all duration-300',
    isHome
      ? 'bg-white/95 backdrop-blur-md border-b border-ink-100'
      : 'border-b border-white/10 text-white',
  ]}
  style={headerBgStyle}
  data-header
  data-variant={variant}
>
  {/* 首页进度条（wpkoi 风格） */}
  <div
    class="absolute bottom-0 left-0 h-0.5 bg-inspur-400 origin-left scale-x-0 transition-transform duration-150"
    data-scroll-progress
    aria-hidden="true"
  ></div>

  <nav class="container-page" aria-label="主导航">
    <div class="flex items-center justify-between h-16">
      <!-- Logo 区 -->
      <a href="/" class="flex items-center gap-2 group" aria-label={`${siteData.name} 首页`}>
        {isHome ? (
          <>
            <img
              src="/img/xdu/xdulogo.png"
              width="44"
              height="44"
              alt="西安电子科技大学"
              class="transition-transform group-hover:scale-105"
            />
            <span class="hidden sm:inline-block w-px h-8 bg-ink-200" aria-hidden="true"></span>
            <img
              src="/img/inspur/inspur_logo.png"
              width="44"
              height="44"
              alt="浪潮"
              class="opacity-90 transition-transform group-hover:scale-105"
            />
          </>
        ) : (
          <>
            <img
              src="/img/inspur/inspur_logo_white.png"
              width="40"
              height="40"
              alt="浪潮俱乐部"
              class="drop-shadow-md transition-transform group-hover:scale-105"
            />
            <span
              class="font-display font-bold text-lg text-white drop-shadow-md hidden sm:inline tracking-wide"
            >
              {siteData.shortName}
            </span>
          </>
        )}
      </a>

      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-1">
        {
          navData.map((item) => (
            <li class="relative group">
              {item.children ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      'px-3 py-2 text-sm font-medium rounded-md transition-colors flex items-center gap-1',
                      isHome
                        ? 'text-ink-700 hover:text-inspur-600'
                        : 'text-white/90 hover:text-white',
                    ]}
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-dropdown-trigger
                  >
                    {item.label}
                    <svg
                      class="w-4 h-4 transition-transform group-hover:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                  <ul
                    class="absolute right-0 top-full mt-1 min-w-[10rem] py-1 bg-white border border-ink-100 rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all"
                    role="menu"
                  >
                    {item.children.map((child) => (
                      <li role="none">
                        <a
                          href={child.href}
                          role="menuitem"
                          class:list={[
                            'block px-4 py-2 text-sm hover:bg-inspur-50 hover:text-inspur-700 transition-colors',
                            isActive(child.href) ? 'text-inspur-600 font-medium' : 'text-ink-700',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'px-3 py-2 text-sm font-medium rounded-md transition-colors relative',
                    isHome
                      ? isActive(item.href)
                        ? 'text-inspur-600'
                        : 'text-ink-700 hover:text-inspur-600'
                      : isActive(item.href)
                        ? 'text-white'
                        : 'text-white/85 hover:text-white',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {/* 当前页底部小竖线指示 */}
                  {isActive(item.href) && !isHome && (
                    <span
                      class="absolute -bottom-1 left-3 right-3 h-0.5 bg-white rounded-full"
                      aria-hidden="true"
                    ></span>
                  )}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- Mobile menu button -->
      <button
        type="button"
        class:list={[
          'md:hidden p-2 rounded-md transition-colors',
          isHome ? 'text-ink-700 hover:bg-ink-50' : 'text-white hover:bg-white/10',
        ]}
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-trigger
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class:list={[
        'hidden md:hidden py-3',
        isHome ? 'border-t border-ink-100' : 'border-t border-white/10',
      ]}
      data-mobile-menu
    >
      <ul class="space-y-1">
        {
          navData.map((item) => (
            <li>
              {item.children ? (
                <details class="group">
                  <summary
                    class:list={[
                      'flex items-center justify-between px-3 py-2 text-sm font-medium rounded-md cursor-pointer transition-colors',
                      isHome ? 'text-ink-700 hover:bg-ink-50' : 'text-white/90 hover:bg-white/10',
                    ]}
                  >
                    {item.label}
                    <svg
                      class="w-4 h-4 transition-transform group-open:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <ul
                    class:list={[
                      'mt-1 ml-4 space-y-1 pl-2',
                      isHome ? 'border-l-2 border-ink-100' : 'border-l-2 border-white/20',
                    ]}
                  >
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-3 py-2 text-sm rounded-md transition-colors',
                            isHome
                              ? isActive(child.href)
                                ? 'text-inspur-600 font-medium'
                                : 'text-ink-600 hover:bg-ink-50'
                              : isActive(child.href)
                                ? 'text-white font-medium'
                                : 'text-white/80 hover:bg-white/10',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3 py-2 text-sm font-medium rounded-md transition-colors',
                    isHome
                      ? isActive(item.href)
                        ? 'text-inspur-600 bg-inspur-50'
                        : 'text-ink-700 hover:bg-ink-50'
                      : isActive(item.href)
                        ? 'text-white bg-white/10'
                        : 'text-white/90 hover:bg-white/10',
                  ]}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  // 1. 移动端菜单开关
  const trigger = document.querySelector('[data-mobile-menu-trigger]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (trigger && menu) {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }

  // 2. wpkoi 风格：滚动进度条 + 滚动时头部磨砂加深
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  const progress = document.querySelector('[data-scroll-progress]') as HTMLElement | null;
  const variant = header?.dataset.variant;

  function onScroll() {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    const pct = total > 0 ? doc.scrollTop / total : 0;

    if (progress) {
      progress.style.transform = `scaleX(${pct})`;
    }

    // subpage 头部：滚动时增加毛玻璃
    if (header && variant === 'subpage') {
      const style = header.style as CSSStyleDeclaration & {
        webkitBackdropFilter?: string;
      };
      if (doc.scrollTop > 20) {
        style.backdropFilter = 'blur(8px)';
        style.webkitBackdropFilter = 'blur(8px)';
        style.backgroundColor = 'rgba(15, 23, 42, 0.35)';
      } else {
        style.backdropFilter = '';
        style.webkitBackdropFilter = '';
        style.backgroundColor = '';
      }
    }
  }

  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 3. wpkoi 风格：滚动进入视口时元素淡入上浮
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => io.observe(el));
  } else {
    // 降级：直接全部显示
    document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
      el.classList.add('is-revealed');
    });
  }
</script>
