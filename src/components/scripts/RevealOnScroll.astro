---
// 滚动入场动画统一入口
// 用 ScrollTrigger.batch 处理所有 [data-reveal] 元素
// 挂在 BaseLayout 头部，页面渲染时自动跑一次。
---

<script>
  import { initGSAP, prefersReducedMotion, revealImmediately } from '@/scripts/gsap-setup';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const REVEAL_SELECTOR = '[data-reveal]';
  const REVEAL_DELAY_ATTR = 'data-reveal-delay';

  function initReveal() {
    const gsap = initGSAP();
    const reduce = prefersReducedMotion();
    const targets = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));

    if (reduce || targets.length === 0) {
      if (reduce) revealImmediately(REVEAL_SELECTOR);
      return;
    }

    // 初始隐藏：让 ScrollTrigger.batch 在元素进入视口时从 opacity 0/translateY 24 切入。
    targets.forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
    });

    ScrollTrigger.batch(targets, {
      start: 'top 88%',
      once: true,
      onEnter: (batch) => {
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.08,
          ease: 'power2.out',
          overwrite: true,
          onStart: () => {
            // 按 data-reveal-delay 微调
            batch.forEach((el) => {
              const delay = parseFloat((el as HTMLElement).getAttribute(REVEAL_DELAY_ATTR) ?? '0');
              if (delay) (el as HTMLElement).style.transitionDelay = '';
            });
          },
        });
      },
    });
  }

  // DOMContentLoaded 之前 Astro 会 defer ESM 脚本，这里直接跑也安全
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal);
  } else {
    initReveal();
  }
</script>
