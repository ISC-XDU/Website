---
// 滚动入场动画统一入口
// 用 ScrollTrigger.batch 处理所有 [data-reveal] 元素
// 挂在 BaseLayout 头部，页面渲染时自动跑一次。
---

<script>
  // GSAP 通过 BaseLayout UMD 加载到 window.gsap + window.ScrollTrigger + window.SplitText
  // 完全不 import gsap-setup（避免 Vite ESM 链触发 GSAP 3.15 TDZ）
  // 这里直接用 window 上的实例

  const REVEAL_SELECTOR = '[data-reveal]';
  const REVEAL_DELAY_ATTR = 'data-reveal-delay';
  const SPLIT_TITLE_SELECTOR = '[data-split-title]';

  function getGsap() {
    if (typeof window === 'undefined') return null;
    return (window as any).gsap ?? null;
  }

  function prefersReducedMotion(): boolean {
    return (
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    );
  }

  function revealImmediately(selector: string): void {
    document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  }

  function initReveal() {
    const gsap = getGsap();
    if (!gsap) return; // UMD 还没加载好（理论上不可能，因为 inline script 在前）
    const reduce = prefersReducedMotion();
    const targets = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));

    if (reduce) {
      revealImmediately(REVEAL_SELECTOR);
      return;
    }

    if (targets.length > 0) {
      // 初始隐藏：让 ScrollTrigger.batch 在元素进入视口时从 opacity 0/translateY 24 切入。
      targets.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
      });

      (window as any).ScrollTrigger.batch(targets, {
        start: 'top 88%',
        once: true,
        onEnter: (batch: any) => {
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.08,
            ease: 'power2.out',
            overwrite: true,
          });
        },
      });
    }
  }

  /**
   * SplitText 字符级标题入场：滚动到标题位置时，字符依次 y 30 落到 0。
   * 适用于 [data-split-title] 标记的 H2 元素。
   */
  function initSplitTitles() {
    const gsap = getGsap();
    if (!gsap) return;
    const reduce = prefersReducedMotion();
    const targets = Array.from(document.querySelectorAll<HTMLElement>(SPLIT_TITLE_SELECTOR));

    if (reduce || targets.length === 0) return;

    targets.forEach((el) => {
      // 跳过已经被 SplitText 处理过的（防止重复挂触发器）
      if (el.dataset.splitDone === '1') return;

      const split = new (window as any).SplitText(el, {
        type: 'chars',
        charsClass: 'gsap-title-char',
        tagName: 'span',
      });
      el.dataset.splitDone = '1';

      // 修复渐变透明继承 bug：原模板里 'text-gradient-rainbow + bg-clip-text
      // + text-transparent' 是在 inline 父级 span 上，SplitText 拆出的字符是
      // inline-block 子元素，父级的 color: transparent 通过 CSS 继承让字符
      // 也变成透明文本，但字符自己的 background 又是空的（父级 inline 渐变
      // 不会扩展到子元素）——结果字符 DOM 在但视觉不可见。
      // 凡是父级有 bg-clip-text 的字符，都把渐变类补到自己身上。
      split.chars.forEach((char: any) => {
        const parent = char.parentElement;
        if (!parent?.classList.contains('bg-clip-text')) return;
        parent.classList.forEach((cls: string) => {
          if (
            cls.startsWith('text-gradient-') ||
            cls === 'bg-clip-text' ||
            cls === 'text-transparent'
          ) {
            char.classList.add(cls);
          }
        });
      });

      gsap.from(split.chars, {
        opacity: 0,
        y: 30,
        duration: 0.6,
        stagger: 0.03,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          once: true,
        },
      });
    });
  }

  function initAll() {
    initReveal();
    initSplitTitles();
  }

  // DOMContentLoaded 之前 Astro 会 defer ESM 脚本，这里直接跑也安全
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>
