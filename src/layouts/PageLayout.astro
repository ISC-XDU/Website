---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  containerClass?: string;
  enableReveal?: boolean;
}

const { title, description, containerClass = 'py-10 md:py-16', enableReveal = true } = Astro.props;
---

<BaseLayout title={title} description={description} enableReveal={enableReveal}>
  <div class:list={['container-page', containerClass]}>
    <slot />
  </div>
</BaseLayout>
