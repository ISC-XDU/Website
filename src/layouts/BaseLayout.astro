---
import '@/styles/global.css';
import SiteHeader from '@components/layout/SiteHeader.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import SkipLink from '@components/layout/SkipLink.astro';
import RevealOnScroll from '@components/scripts/RevealOnScroll.astro';
import siteData from '@data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** 强制 header 变体；不传则根据路径自动判断（'/' = home, 其他 = subpage） */
  headerVariant?: 'home' | 'subpage';
  /** 启用 ScrollTrigger 滚动入场动画（仅主页 5 段使用） */
  enableReveal?: boolean;
}

const {
  title,
  description = siteData.description,
  image = '/favicon.svg',
  noindex = false,
  headerVariant,
  enableReveal = false,
} = Astro.props;

// 自动判断：根路径是 home，其他都是 subpage
const variant = headerVariant ?? (Astro.url.pathname === '/' ? 'home' : 'subpage');

const fullTitle = title ? `${title} | ${siteData.name}` : `${siteData.name} | ${siteData.slogan}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    {/* 标签页图标：浪潮俱乐部"飞人"社团图标（区别于浪潮集团 LOGO） */}
    <link rel="icon" type="image/png" href="/img/inspur/inspur_logo.png" />

    {/* 深色模式初始化（必须在 body 渲染前执行，避免主题闪烁） */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    {/* GSAP UMD 加载（绕开 GSAP 3.15 ESM 在 Vite inline 时的 TDZ 循环依赖问题）
        按依赖顺序：核心 → 3 个插件，全部同步挂到 window */}
    <script is:inline src="/vendor/gsap.js"></script>
    <script is:inline src="/vendor/ScrollTrigger.js"></script>
    <script is:inline src="/vendor/SplitText.js"></script>
    <script is:inline src="/vendor/MorphSVGPlugin.js"></script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteData.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
  </head>

  <body class="min-h-screen flex flex-col">
    <SkipLink />
    <SiteHeader variant={variant} />
    <main id="main-content" class:list={['flex-1', variant === 'home' ? 'pt-16' : 'pt-16']}>
      <slot />
    </main>
    <SiteFooter />
    {enableReveal && <RevealOnScroll />}
  </body>
</html>
