{
  "name": "inspur-website-v2",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Xidian Inspur Student Club (ISC) website — modern rewrite with Astro + TypeScript + Tailwind CSS",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{js,ts,astro,md,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^4.16.18",
    "gsap": "^3.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "_gsap_note": "GSAP 自 2024-05 由 Webflow 收购后所有插件 100% 免费（含 SplitText / MorphSVG / MorphSVGPlugin / DrawSVG / Physics2D 等），可直接 import 无需商业授权。",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
